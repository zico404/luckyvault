<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LuckyVault" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FF0A120B</item>
        <item name="android:navigationBarColor">#FF0A120B</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>

    <style name="Theme.LuckyVault.Splash" parent="Theme.LuckyVault">
